{
  "name": "muni-san-roque",
  "version": "1.1.0",
  "private": true,
  "description": "Portal informativo de la Municipalidad Distrital de San Roque de Cumbaza",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i css/input.css -o css/styles.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i css/input.css -o css/styles.css --watch",
    "serve": "npx --yes serve -l 5173 .",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.0.0",
    "@fortawesome/fontawesome-free": "^6.5.0",
    "tailwindcss": "^3.4.0"
  },
  "type": "module"
}
